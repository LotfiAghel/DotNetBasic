@using AdminBaseComponenets.BaseComs
@code {
    private Dictionary<string, FileUploader.State> uploadingFiles = new();
    private System.Threading.Timer timer;

    protected override void OnInitialized()
    {
        timer = new System.Threading.Timer(_ =>
        {
            // Get a snapshot of current uploading files
            var files = FileUploader.instnace.Files
                .Where(kv => kv.Value != null && !kv.Value.Completed)
                .ToDictionary(kv => kv.Key, kv => kv.Value);

            uploadingFiles = files;
            InvokeAsync(StateHasChanged);
        }, null, 0, 500); // update every 500ms
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}

@if (uploadingFiles.Count > 0)
{
    <div style="position:fixed; left:16px; bottom:16px; z-index:9999; min-width:220px; background:rgba(30,30,30,0.95); color:#fff; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.2); padding:12px 16px; font-size:14px;">
        <div style="font-weight:bold; margin-bottom:8px;">در حال آپلود فایل‌ها...</div>
        @foreach (var file in uploadingFiles)
        {
            <div style="margin-bottom:8px;">
                <div style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px;" title="@file.Key">@file.Key</div>
                <div class="progress" style="height: 12px; background:#444;">
                    <div class="progress-bar" role="progressbar"
                         style="width: @file.Value.ProgressPercentage%; background:#4caf50;"
                         aria-valuenow="@file.Value.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <div style="font-size:11px; color:#ccc;">@file.Value.ProgressPercentage%</div>
            </div>
        }
    </div>
}