@typeparam T

@inherits ValueInput<Nullable<T>>


<div class="row pt-2 pb-2" @key=@dataId>
    @if (value != null )
    {
        if (viewComponenet != null)
        {
            <div class="col-sm-10">
                <div @key=@dataId>@Program0.CreateDynamicComponent2(this, viewComponenet, value)</div>
            </div>


        }
        else
        {
            <div> @(value.ToString())</div>
        }
    }
    else
    {
        <div>null</div>
    }

</div>
