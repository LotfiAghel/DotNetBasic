@using System.Linq
@using Microsoft.Extensions.Logging
@using System;
@using System.Net;
@using Newtonsoft.Json.Linq;
@using Newtonsoft.Json;



@using System.Collections.Generic;
@using System.ComponentModel.DataAnnotations;
@using System.ComponentModel.DataAnnotations.Schema;
@using Tools;
@using System.Net.Http;
@using System.Net.Http.Json;
@using System.Collections;
@using AdminBaseComponenets;
@using Models




@if (value != null)
{
    Action<object> onClick2 = async (x) =>
    {
        await Click();
    };
    if (value is TreeNode trNode)
    {
        //if (openOject)
        
            <BarItem>
                <BarDropdown RightAligned>
                    <BarDropdownToggle>
                        <BarIcon IconName="IconName.Circle"  />
                        @(value.name)
                    </BarDropdownToggle>
                    <BarDropdownMenu style="@($"background-color: #f0f0f0;padding-right: {2 * 10}px;")">
                        @foreach (var line in trNode.children)
                        {
                            
                                <MenuTreeView value=@line  />
                            
                        }
                    </BarDropdownMenu>
                </BarDropdown>
            </BarItem> 
        
    }
    else if (value is EntityModel eM && Program0.checkPermission<SelectAccess>(eM.Type))
    {
        var link = $"page/{eM.Type.GetUrlEncodeName()}";
        var name = eM.Type.GetPerisanName();
        if (eM.name != null)
            name = eM.name;

        <BarItem  title=@name><BarLink To=@link><BarIcon IconName="IconName.Pen"  />@name</BarLink></BarItem>
        
        
    }else if (value is PageViewNode t)
                {
                    
                    

                    <BarItem title=@t.name>
                        <BarLink To=@t.url><BarIcon IconName="IconName.Search"  />@t.name</BarLink>
                    </BarItem>
                    
                }else if(value is ApiViewNode t2 ){

                    var link = $"apiPage/{Program0.ConvertUrl(t2.url)}";
                    

                    <BarItem title=@(((ATreeNode)t2).name)>
                        <BarLink To=@link><BarIcon IconName="IconName.Search"  />@(((ATreeNode)t2).name)
                        </BarLink>
                    </BarItem>

                }
            
}



@code {

    [Parameter]
    public ATreeNode value { get; set; }

    public bool openOject = false;
    async Task Click()
    {
        openOject = !openOject;
    }






}
