@using System.Net.Http
@using Blazorise.Snackbar
@using System.Linq
<ModalHeader>
    <ModalTitle>
        انتخاب فایل از سرور
    </ModalTitle>
    <CloseButton />
</ModalHeader>
<ModalBody>
<div>
    <div class="filebrowser-form">
        
        <div class="body">
                @if (IsLoading)
                {
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="sr-only">در حال بارگذاری...</span>
                        </div>
                        <p class="mt-2">در حال بارگذاری فایل‌ها...</p>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-1">
                            <nav aria-label="breadcrumb" class="flex-grow-1 mb-0">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item">
                                        <a href="#" @onclick="() => NavigateToPath(null)" @onclick:preventDefault>ریشه</a>
                                    </li>
                                    @if (!string.IsNullOrEmpty(CurrentPath))
                                    {
                                        var pathParts = CurrentPath.Split('/').Where(p => !string.IsNullOrEmpty(p)).ToArray();
                                        var currentBuildPath = "";
                                        for (int i = 0; i < pathParts.Length; i++)
                                        {
                                            currentBuildPath += pathParts[i];
                                            var displayPath = currentBuildPath;
                                            <li class="breadcrumb-item @(i == pathParts.Length - 1 ? "active" : "")">
                                                @if (i < pathParts.Length - 1)
                                                {
                                                    <a href="#" @onclick="() => NavigateToPath(displayPath)" @onclick:preventDefault>@pathParts[i]</a>
                                                }
                                                else
                                                {
                                                    @pathParts[i]
                                                }
                                            </li>
                                            currentBuildPath += "/";
                                        }
                                    }
                                </ol>
                            </nav>
                            <button class="btn btn-sm btn-outline-success ms-2" title="افزودن به بوکمارک" style="font-size:1.1rem;padding:2px 6px;" @onclick="AddQuickAccess">
                                +
                            </button>
                        </div>
                    </div>
                    @if (QuickAccessDirs.Count > 0)
                    {
                        <div class="mt-2 border-top pt-2 d-flex flex-wrap align-items-center" style="font-size:0.95rem;">
                            <span class="me-2 text-muted" style="font-size:0.95rem;">بوکمارک‌ها:</span>
                            @foreach (var quick in QuickAccessDirs)
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1 mb-1" style="font-size:0.95rem;padding:2px 8px;" title="@quick" @onclick="() => NavigateToPath(quick)">
                                    @System.IO.Path.GetFileName(quick)
                                </button>
                            }
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="mb-3 d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="OpenCreateDirectoryModal">
                            <span class="oi oi-plus mr-2" aria-hidden="true"></span>
                            @( "ایجاد پوشه" )
                        </button>
                        <button type="button" class="btn btn-outline-primary" @onclick="OpenUploadFileModal">
                            <span class="oi oi-cloud-upload mr-2" aria-hidden="true"></span>
                            @( "آپلود فایل" )
                        </button>
                    </div>


                    <!-- Search box for filtering files -->
                    <div class="mb-2">
                        <input class="form-control" type="text" placeholder="جستجو در نام فایل‌ها..."
                               @bind="SearchTerm" @bind:event="oninput"
                               style="max-width: 300px; display: inline-block;" />
                    </div>
                    <div class="file-list" style="max-height: 400px; overflow-y: auto;">
                        @if (BrowserResponse?.Items != null && BrowserResponse.Items.Any())
                        {
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>تصویر</th>
                                        <th>نام</th>
                                        <th>نوع</th>
                                        <th>اندازه</th>
                                        <th>تاریخ تغییر</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in BrowserResponse.Items)
                                    {
                                        <tr>
                                            <td>
                                                @if (!item.IsDirectory && IsImageFile(item.Extension))
                                                {
                                                    <img src="@GetThumbnailUrl(item.Path)" alt="thumbnail"
                                                         style="width:40px;height:40px;object-fit:cover;vertical-align:middle;"
                                                         loading="lazy"
                                                         onerror="this.onerror=null;this.src='/images/image-placeholder.png';" />
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsDirectory)
                                                {
                                                    <i class="oi oi-folder text-warning mr-2"></i>
                                                    <a href="#" @onclick="() => NavigateToPath(item.Path)" @onclick:preventDefault>@item.Name</a>
                                                }
                                                else
                                                {
                                                    <i class="oi oi-file text-primary mr-2"></i>
                                                    @item.Name
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsDirectory)
                                                {
                                                    <span class="badge badge-secondary">پوشه</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-info">@item.Extension.ToUpper()</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsDirectory)
                                                {
                                                    <span>-</span>
                                                }
                                                else
                                                {
                                                    @FormatFileSize(item.Size)
                                                }
                                            </td>
                                            <td>@item.LastModified.ToString("yyyy/MM/dd HH:mm")</td>
                                            <td>
                                                @if (!item.IsDirectory)
                                                {
                                                    <button type="button" class="btn btn-sm btn-success" @onclick="() => OnSuccessClicked(item)">
                                                        انتخاب
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <!-- Pagination Controls -->
                            <div class="d-flex justify-content-center align-items-center mt-2">
                                <button class="btn btn-sm btn-outline-secondary mx-1"
                                        @onclick="PrevPage"
                                        disabled="@(CurrentPage <= 1)">
                                    قبلی
                                </button>
                                <span class="mx-2">
                                    صفحه @CurrentPage از @TotalPages
                                </span>
                                <button class="btn btn-sm btn-outline-secondary mx-1"
                                        @onclick="NextPage"
                                        disabled="@(CurrentPage >= TotalPages)">
                                    بعدی
                                </button>
                                <span class="mx-2">
                                    (تعداد کل: @BrowserResponse.TotalCount)
                                </span>
                                <select class="form-control form-control-sm d-inline-block w-auto mx-2"
                                        @onchange="OnPageSizeChanged"
                                        value="@PageSize">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="mx-1">در هر صفحه</span>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="oi oi-folder" style="font-size: 3rem;"></i>
                                <p class="mt-2">هیچ فایلی در این مسیر یافت نشد</p>
                            </div>
                            
                        }
                    </div>
                }
            </div>
            <div class="footer">
                <button type="button" class="btn btn-secondary" @onclick="OnCancelClicked">لغو</button>
            </div>
        </div>
    </div>


<!-- Create Directory Modal -->
<div class="modal fade @CreateDirectoryModalClass" id="createDirectoryModal" tabindex="-1" role="dialog" aria-labelledby="createDirectoryModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createDirectoryModalLabel">ایجاد پوشه جدید</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" @onclick="CloseCreateDirectoryModal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="directoryName">نام پوشه:</label>
                    <input type="text" class="form-control" id="directoryName" @bind="NewDirectoryName" @bind:event="oninput"
                           placeholder="نام پوشه را وارد کنید" maxlength="50" />
                    <small class="form-text text-muted">
                        نام پوشه نمی‌تواند شامل کاراکترهای خاص مانند / \ : * ? " &lt; &gt; | باشد
                    </small>
                </div>
                @if (!string.IsNullOrEmpty(CreateDirectoryError))
                {
                    <div class="alert alert-danger mt-2">
                        @CreateDirectoryError
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseCreateDirectoryModal">لغو</button>
                <button type="button" class="btn btn-primary" @onclick="CreateDirectory" disabled="@(!CanCreateDirectory || IsCreatingDirectory)">
                    @if (IsCreatingDirectory)
                    {
                        <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                        @( "در حال ایجاد..." )
                    }
                    else
                    {
                        @( "ایجاد پوشه" )
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Upload File Modal -->
<div class="modal fade @(ShowUploadFileModal ? "show d-block" : "")" id="uploadFileModal" tabindex="-1" role="dialog" aria-labelledby="uploadFileModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadFileModalLabel">آپلود فایل در پوشه جاری</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" @onclick="CloseUploadFileModal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <InputFile OnChange="OnUploadFileInputChange" />
                @if (!string.IsNullOrEmpty(UploadFileError))
                {
                    <div class="alert alert-danger mt-2">
                        @UploadFileError
                    </div>
                }
                @if (IsUploadingFile)
                {
                    <div class="mt-2">
                        <div class="progress">
                            <div class="progress-bar" role="progressbar" style="width: @UploadProgress%;" aria-valuenow="@UploadProgress" aria-valuemin="0" aria-valuemax="100">@UploadProgress%</div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseUploadFileModal" disabled="@IsUploadingFile">لغو</button>
                <button type="button" class="btn btn-primary" @onclick="UploadFile" disabled="@(SelectedUploadFile == null || IsUploadingFile)">
                    @if (IsUploadingFile)
                    {
                        <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                        @( "در حال آپلود..." )
                    }
                    else
                    {
                        @( "آپلود" )
                    }
                </button>
            </div>
        </div>
    </div>
</div>

</ModalBody>
<ModalFooter>
    
    <Button Color="Color.Secondary" Clicked="OnCancelClicked">Close</Button>
</ModalFooter>
