@using Blazorise.Video;
@inherits ValueInput<string>


<Row>
    <StringInput value=@value OnChange=OnChange />
</Row>
<div>
    @FilesDirectory 
</div>
@if (!string.IsNullOrWhiteSpace(value))
{
    
    if (FileUploader.instnace.getState(value) == null)
    {
        if (value.ToLower().EndsWith(".png") || value.ToLower().EndsWith(".jpg"))
        {
            <img src=@($"{ClTool.WebClient.webClient.baseUrl}{FilesDownloadDirectory}/{value}?t={cacheBuster}") class="img" style="width: auto; height: 200px;"/>
        }

        if (value.ToLower().EndsWith(".mp3") || value.ToLower().EndsWith(".ogg"))
        {
            <MyAudio src=@($"{ClTool.WebClient.webClient.baseUrl}{FilesDownloadDirectory}/{value}?t={cacheBuster}")  ></MyAudio>
        }
        if (value.ToLower().EndsWith(".mp4"))
        {
            <Video Source=@($"{ClTool.WebClient.webClient.baseUrl}{FilesDownloadDirectory}/{value}?t={cacheBuster}")  ></Video>
        }

        
    }
    else
    {
        <div class="progress mb-3" style="height: 20px;">
            <div class="progress-bar" role="progressbar" style="width: @ProgressPercentage%;" aria-valuenow="@ProgressPercentage" aria-valuemin="0" aria-valuemax="100">@ProgressPercentage% Complete</div>
        </div>
    }

    <Button Color=@Color.Danger Clicked=@(()=> setNull())>null</Button>
}
else
{
    <div class="@AlertClass" role="alert">
        @AlertMessage
    </div>
    

    <div class="d-flex gap-2 mb-3">
        <form @onsubmit="OnSubmit" class="needs-validation flex-grow-1" novalidate>
            <div class="input-group">
                <InputFile @key=@(inputFileId) class="form-control" id="inputFile" OnChange="OnInputFileChange" aria-describedby="uploadButton" required />
                <button class="btn btn-primary" type="submit" id="uploadButton" disabled="@IsUploadDisabled">
                    <span class="oi oi-cloud-upload" aria-hidden="true"></span> آپلود فایل
                </button>
            </div>
            <div class="invalid-feedback">
                لطفا فایلی برای آپلود انتخاب کنید.
            </div>
        </form>
        <div class="flex-shrink-0 d-flex gap-2">
            <!-- Upload and file browser buttons are available when used in AdminClient context -->
            <button type="button" class="btn btn-outline-primary" @onclick="ShowFileBrowser">
                <span class="oi oi-folder" aria-hidden="true"></span> انتخاب از سرور
            </button>
        </div>
    </div>
@if (ShowFileBrowserModal)
{
    <FileBrowser IsVisible="ShowFileBrowserModal"
                 IsVisibleChanged="OnFileBrowserModalClosed"
                 OnFileSelected="OnFileSelectedFromBrowser" />
}
}

<!-- FileBrowser and FileUploadModal components are available in AdminClient project -->

@code
{
    [CascadingParameter(Name="FilesDirectory")]
    public string FilesDirectory { get; set; }

    [CascadingParameter(Name = "FilesDownloadDirectory")]
    public string FilesDownloadDirectory { get; set; } = "Upload";

    // Note: FileBrowser and FileUploadModal components are available in AdminClient project
    // These would be used when FileUploadBig is used in AdminClient context

    // Note: FileBrowser and FileUploadModal functionality is available in AdminClient project
    // When FileUploadBig is used in AdminClient context, these methods would be implemented
}
